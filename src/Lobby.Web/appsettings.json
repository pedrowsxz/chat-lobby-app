{
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "DataPath": "data",
    "AllowRegistration": true,
    "BehindProxy": false
  },
  "Demo": {
    "SimulateReplies": true
  },
  "RateLimits": {
    "GuestsPerHourPerIp": 10,
    "MessagesPer10Seconds": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
