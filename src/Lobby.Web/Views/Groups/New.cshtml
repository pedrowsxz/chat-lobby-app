@model NewGroupViewModel
@{ ViewData["Title"] = "Novo grupo"; }
<div class="page-narrow">
    <h1 class="h3 mb-4">Novo grupo</h1>
    <form method="post" action="/grupos/novo" asp-antiforgery="true" class="card card-body">
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@Model.Error</div>
        }
        <div class="mb-3">
            <label for="Name" class="form-label">Nome do grupo</label>
            <input id="Name" name="Name" value="@Model.Name" class="form-control" maxlength="60" required />
        </div>
        <p class="form-text mt-0">Até @Model.MaxMembers pessoas, contando com você. Qualquer membro pode adicionar outras pessoas.</p>
        <partial name="_PeoplePicker" model="(Model.Candidates, Model.MemberIds)" />
        <div class="mt-3"><button type="submit" class="btn btn-accent">Criar grupo</button></div>
    </form>
</div>
